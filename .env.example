# Copy to .env.local for local development, and set the same values in your
# hosting provider for production.

# ── Database (Neon Postgres) ─────────────────────────────────────────────────
# Connection string for the Postgres database that stores game results.
# Used by the app at runtime and by drizzle-kit for migrations.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
# From https://dashboard.clerk.com → your app → API keys.
# Without these, every request fails in the proxy (middleware).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ── App URL ──────────────────────────────────────────────────────────────────
# Absolute base URL, used for metadata and server-side fetches.
# On Vercel this falls back to VERCEL_URL automatically, so it is only required
# if you serve the app from a custom domain.
# NEXT_PUBLIC_APP_URL="https://guessthewiki.example.com"
